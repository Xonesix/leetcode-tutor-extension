{
  "name": "LeetCoach Interview Assistant",
  "description": "AI tutor and mock interviewer for LeetCode and NeetCode problems.",
  "version": "1.0",
  "manifest_version": 3,

  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "clipboardWrite"
  ],

  "host_permissions": [
    "https://leetcode.com/*",
    "https://neetcode.io/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.openai.com/*",
    "https://api.anthropic.com/*"
  ],

  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },

  "action": {
    "default_popup": "popup/popup.html"
  },

  "background": {
    "service_worker": "background.js"
  },

  "content_scripts": [
    {
      "matches": [
        "https://leetcode.com/problems/*",
        "https://neetcode.io/problems/*"
      ],
      "js": ["content/content.js"]
    }
  ],

  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; connect-src https://generativelanguage.googleapis.com https://api.anthropic.com https://api.openai.com; media-src 'self' blob:;"
  },

  "options_page": "options/options.html"
}
