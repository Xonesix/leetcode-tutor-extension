{
  "name": "LeetCode Interview Coach",
  "description": "Gives voice advice like a real coding interview",
  "version": "1.0",
  "manifest_version": 3,

  "permissions": [
    "activeTab",
    "scripting"
  ],

  "host_permissions": [
    "https://leetcode.com/*"
  ],

  "action": {
    "default_popup": "hello.html"
  },

  "content_scripts": [
    {
      "matches": ["https://leetcode.com/problems/*"],
      "js": ["content.js"]
    }
  ]
}
